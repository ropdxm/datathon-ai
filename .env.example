# Copy to .env. Shell syntax: quote paths containing spaces. Do not commit .env.
# Default is unconfigured: upload preview and the labelled UI demo work,
# but no model decision is generated until a real analyzer is configured.

# Full event analyzer supplied by your ML teammate (recommended):
# FORTE_ANALYZER="my_team.analyzer:analyze_video"

# Or an extracted offline bundle from the Colab notebooks (binary baseline):
# FORTE_MODEL_BUNDLE="/absolute/path/to/extracted/bundle"

FORTE_DEVICE="auto"
HOST="127.0.0.1"
PORT="8000"

# If absent, run-web.sh creates a random persistent key in .forte-runtime.
# FORTE_API_KEY="replace-with-a-long-random-private-key"
